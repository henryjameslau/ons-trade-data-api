{
  "name": "ons-trade-data-api",
  "version": "1.0.0",
  "description": "Client-side API for UK trade data from ONS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "parse-data": "ts-node --esm scripts/parse-excel.ts data/parsed.json data/raw/countrybycommodityexports.xlsx data/raw/countrybycommodityimports.xlsx",
    "generate-files": "ts-node --esm scripts/generate-files.ts data/parsed.json",
    "refresh-data": "npm run parse-data && npm run generate-files"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "^26.1.2",
    "svelte": "^5.56.8",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "xlsx": "^0.18.5"
  }
}
